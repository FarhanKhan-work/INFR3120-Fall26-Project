# Copy this file to .env and fill in your real values.
# Do NOT commit the real .env (it is in .gitignore).

# Your MongoDB Atlas connection string.
# Get it from Atlas: Database > Connect > Drivers.
# Replace <username>, <password> and the cluster host with yours.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giglink?retryWrites=true&w=majority

# Port the app runs on (optional, defaults to 3000)
PORT=3000
